# =====================================================
# 将此文件复制为 .env 并填入实际值
#   cp .env.example .env
#  .env 已加入 .gitignore，不会被提交到仓库
# =====================================================

# MySQL root 密码（docker-compose db 服务使用）
MYSQL_ROOT_PASSWORD=你的root密码

# MySQL 应用用户密码（与下方 DATABASE_URL 中的密码一致）
MYSQL_PASSWORD=你的note_user密码

# Next.js 应用数据库连接串
DATABASE_URL="mysql://note_user:你的note_user密码@db:3306/kaoyan_notes"

# 部署后的域名（必填，用于 NextAuth 回调）
NEXTAUTH_URL="https://你的域名.com"

# 会话加密密钥，用 openssl rand -base64 32 生成一个填到这里
NEXTAUTH_SECRET="这里填生成的密钥"
